{
  "manifest_version": 3,
  "name": "Anki CSV Importer",
  "version": "1.0.0",
  "description": "从网页CSV内容解析并导入到Anki笔记",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8765/*"
  ],
  "action": {
    "default_title": "Anki CSV Importer",
    "default_popup": "popup.html",
    "default_icons": {
      "32": "icons/anki32.png",
      "48": "icons/anki48.png",
      "128": "icons/anki128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "32": "icons/anki32.png",
    "48": "icons/anki48.png",
    "128": "icons/anki128.png"
  }
}
